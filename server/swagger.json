          "200": {
            "description": "Customization updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardCustomization"
                }
              }
            }
          },
          "400": {
            "description": "Invalid customization data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/xo-board-customization": {
      "get": {
        "tags": ["Customization"],
        "summary": "Get Tic-tac-toe board customization",
        "description": "Retrieve the user's Tic-tac-toe board customization settings",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Customization retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardCustomization"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Customization"],
        "summary": "Update Tic-tac-toe board customization",
        "description": "Update the user's Tic-tac-toe board customization settings",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BoardCustomizationUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customization updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardCustomization"
                }
              }
            }
          },
          "400": {
            "description": "Invalid customization data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },

    "/api/tictactoe/queue-count": {
      "get": {
        "tags": ["Matchmaking"],
        "summary": "Get Tic-tac-toe queue count",
        "description": "Get the number of players currently waiting in the matchmaking queue",
        "security": [],
        "responses": {
          "200": {
            "description": "Queue count retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueCount"
                }
              }
            }
          }
        }
      }
    },

    "/uploads/{filename}": {
      "get": {
        "tags": ["Files"],
        "summary": "Get uploaded file",
        "description": "Retrieve an uploaded file (typically user avatars)",
        "security": [],
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "description": "Name of the uploaded file",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File retrieved",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionId",
        "description": "Session-based authentication using httpOnly cookies. Login to obtain a session."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["success"]
      },
      "UserRegistration": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 64
          },
          "display_name": {
            "type": "string"
          }
        },
        "required": ["username", "email", "password"]
      },
      "UserLogin": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["username", "password"]
      },
      "GoogleAuth": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "googleId": {
            "type": "string"
          }
        },
        "required": ["idToken"]
      },
      "AuthResponse": {
        "type": "object",
        "description": "Authentication response. A session cookie is set automatically on successful login/registration.",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["user"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "display_name": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "last_active": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "board_customization": {
            "type": "object",
            "nullable": true,
            "description": "Pong board customization settings, null if not set"
          },
          "xo_board_customization": {
            "type": "object",
            "nullable": true,
            "description": "Tic-tac-toe board customization settings, null if not set"
          }
        },
        "required": ["id", "username", "email", "created_at", "updated_at"]
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["user"]
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "avatar_url": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "current_password": {
            "type": "string"
          }
        }
      },
      "UserSearchResults": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserSearchResult"
            }
          }
        },
        "required": ["users"]
      },
      "UserSearchResult": {
        "type": "object",
        "description": "User search result - subset of user fields",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "display_name": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "FriendsList": {
        "type": "object",
        "properties": {
          "friends": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Friend"
            }
          }
        },
        "required": ["friends"]
      },
      "Friend": {
        "type": "object",
        "description": "Friend object returned from getFriends - subset of User with online status",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "is_online": {
            "type": "integer",
            "enum": [0, 1],
            "description": "1 if user was active in last 10 seconds, 0 otherwise"
          }
        }
      },
      "FriendRequests": {
        "type": "object",
        "properties": {
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FriendRequestItem"
            }
          }
        },
        "required": ["requests"]
      },
      "FriendRequestItem": {
        "type": "object",
        "description": "Friend request item - contains basic user info of the requester/recipient",
        "properties": {
          "id": {
            "type": "integer",
            "description": "User ID of the person who sent/received the request"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the friend request was created"
          }
        }
      },
      "FriendRequest": {
        "type": "object",
        "properties": {
          "friend_id": {
            "type": "integer"
          }
        },
        "required": ["friend_id"]
      },
      "BlockUser": {
        "type": "object",
        "properties": {
          "blocked_user_id": {
            "type": "integer"
          }
        },
        "required": ["blocked_user_id"]
      },
      "BlockedUsers": {
        "type": "object",
        "properties": {
          "blockedUsers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlockedUser"
            }
          }
        },
        "required": ["blockedUsers"]
      },
      "BlockedUser": {
        "type": "object",
        "description": "Blocked user info",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the user was blocked"
          }
        }
      },
      "UserStats": {
        "type": "object",
        "properties": {
          "stats": {
            "type": "object",
            "properties": {
              "total_games": {
                "type": "integer"
              },
              "wins": {
                "type": "integer"
              },
              "losses": {
                "type": "integer"
              },
              "draws": {
                "type": "integer"
              },
              "win_rate": {
                "type": "number"
              },
              "tournaments_won": {
                "type": "integer"
              },
              "current_win_streak": {
                "type": "integer"
              },
              "longest_win_streak": {
                "type": "integer"
              }
            }
          }
        },
        "required": ["stats"]
      },
      "MatchHistory": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          }
        },
        "required": ["matches"]
      },
      "Match": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "opponent_id": {
            "type": "integer",
            "nullable": true
          },
          "user_score": {
            "type": "integer"
          },
          "opponent_score": {
            "type": "integer"
          },
          "result": {
            "type": "string",
            "enum": ["win", "loss", "draw"]
          },
          "game_type": {
            "type": "string",
            "enum": ["pong", "tictactoe", "tournament"]
          },
          "played_at": {
            "type": "string",
            "format": "date-time"
          },
          "opponent_username": {
            "type": "string",
            "nullable": true,
            "description": "Username of the opponent (from JOIN)"
          },
          "opponent_display_name": {
            "type": "string",
            "nullable": true,
            "description": "Display name of the opponent (from JOIN)"
          }
        }
      },
      "OfflineMatch": {
        "type": "object",
        "properties": {
          "playerScore": {
            "type": "integer"
          },
          "aiScore": {
            "type": "integer"
          },
          "result": {
            "type": "string",
            "enum": ["win", "loss", "draw"]
          },
          "difficulty": {
            "type": "string"
          },
          "gameType": {
            "type": "string",
            "default": "pong"
          }
        },
        "required": ["playerScore", "aiScore", "result"]
      },
      "TournamentWin": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer"
          },
          "rounds": {
            "type": "integer"
          }
        },
        "required": ["size", "rounds"]
      },
      "BoardCustomization": {
        "type": "object",
        "properties": {
          "customization": {
            "type": "object",
            "nullable": true,
            "properties": {
              "theme": {
                "type": "string"
              },
              "colors": {
                "type": "object"
              }
            }
          }
        },
        "required": ["customization"]
      },
      "BoardCustomizationUpdate": {
        "type": "object",
        "properties": {
          "customization": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string"
              },
              "colors": {
                "type": "object"
              }
            }
          }
        },
        "required": ["customization"]
      },
      "QueueCount": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          }
        },
        "required": ["count"]
      }
    }
  }
}
